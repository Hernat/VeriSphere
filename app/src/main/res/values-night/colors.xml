<?xml version="1.0" encoding="utf-8"?>
<!--
  VeriSphere palette — UX Step 8 (dark variants).
  Auto-applied by the platform when the device is in dark mode.
  VeriSphereTheme.kt has dynamicColor=false; we follow system light/dark only.
-->
<resources>

    <!-- Surfaces -->
    <color name="vs_background">#121212</color>
    <color name="vs_surface_variant">#1E1E1E</color>
    <color name="vs_on_background">#E8E8E8</color>
    <color name="vs_on_background_muted">#9AA0A6</color>

    <!-- Brand accent — Google Blue, dark variant.
         vs_on_brand_google_blue uses dark text on the lighter dark-mode
         blue so contrast stays > 4.5:1 (WCAG AA body text). -->
    <color name="vs_brand_google_blue">#8AB4F8</color>
    <color name="vs_on_brand_google_blue">#1F1F1F</color>

    <!-- Verdict semantic colours, dark variants -->
    <color name="vs_verdict_true">#34A853</color>
    <color name="vs_verdict_false">#F28B82</color>
    <color name="vs_verdict_doubtful">#FDD663</color>
    <color name="vs_verdict_non_verifiable">#9AA0A6</color>

    <!-- Failure / state colours -->
    <color name="vs_state_offline">#E8E8E8</color>
    <!-- Story 3.3 patch P2 — on-colour for vs_state_offline dark variant.
         Dark text on the #E8E8E8 near-white dark-mode surface gives ~16:1
         contrast (WCAG AA / AAA). Without this, the previously-hardcoded
         Color.White verdict word rendered at ~1.04:1 — effectively invisible. -->
    <color name="vs_on_state_offline">#1F1F1F</color>

    <!-- Story 7.5 C13 — on-colours for vs_verdict_doubtful + vs_verdict_non_verifiable
         dark variants (Story 3.3 D1 + D2 closure). The amber #FDD663 dark-mode
         doubtful background still needs DARK text for WCAG AA — same value
         as light per UX Step 8 amber-is-theme-independent footnote. The grey
         #9AA0A6 dark-mode background needs DARK text for ~6.5:1 contrast
         (WCAG AAA) — the previously-hardcoded Color.White rendered at
         ~2.55:1 (FAIL WCAG AA), the C13 fix. -->
    <color name="vs_on_verdict_doubtful">#1F1F1F</color>
    <color name="vs_on_verdict_non_verifiable">#1F1F1F</color>

    <!-- Privacy padlock -->
    <color name="vs_privacy_padlock">#81C995</color>

    <!-- Story 6.2 — Update-available dot on bubble (epics L892 dark variant). -->
    <color name="vs_update_dot">#5F6368</color>

    <!-- ============================================================
         Epic 8 Story 8.1 — Wispr Flow inspired tokens (dark variants).
         See values/colors.xml for the light counterparts + the
         migration narrative.
         ============================================================ -->

    <!-- Neutrals (dark): warm deep brown ink → ivory text. -->
    <color name="vs_canvas">#1A1612</color>
    <color name="vs_paper">#221E18</color>
    <color name="vs_paper_alt">#2C2620</color>
    <color name="vs_ink">#F0EADC</color>
    <color name="vs_ink_muted">#B0A99C</color>
    <!-- Code-review F3 (Group B) — was #7C7568 (3.85:1 on paper, FAIL
         WCAG AA body in dark mode). Lifted to #908A7E (5.14:1 on
         paper, PASSES AA body). Mirrors the light-mode darkening of
         the corresponding token (cross-theme symmetry preserved). -->
    <color name="vs_ink_soft">#908A7E</color>
    <color name="vs_hairline">#3A332A</color>

    <!-- Accents (dark) — lifted sage / lavender / pulse for dark-mode
         contrast against vs_canvas=#1A1612. -->
    <color name="vs_accent_sage">#9CC2A8</color>
    <color name="vs_accent_sage_deep">#7BA889</color>
    <color name="vs_accent_lavender">#B5ABCE</color>
    <color name="vs_accent_pulse">#DDB97A</color>
    <!-- Dark sage is lifted (#9CC2A8) so dark text on it stays AA.
         vs_on_accent_sage_deep stays dark too in dark mode — sage_deep
         #7BA889 + #1A1612 ink gives ~7.8:1 (AAA). -->
    <color name="vs_on_accent_sage">#1A1612</color>
    <color name="vs_on_accent_sage_deep">#1A1612</color>
    <!-- Code-review F8 (Group B) — on-colour for vs_accent_pulse dark
         variant (#DDB97A). Dark ink on the lifted gold gives ~9:1
         (AAA). Symmetric to the light variant — both modes use dark
         text on the gold pulse surface. -->
    <color name="vs_on_accent_pulse">#1A1612</color>

    <!-- Verdict softs (dark) — deepened backgrounds, light foreground
         on-colours for AA contrast. -->
    <color name="vs_verdict_true_soft">#1F3326</color>
    <color name="vs_verdict_false_soft">#3D1F1A</color>
    <color name="vs_verdict_doubtful_soft">#3D3320</color>
    <color name="vs_verdict_non_verifiable_soft">#2A2330</color>

    <color name="vs_on_verdict_true_soft">#C8E6CF</color>
    <color name="vs_on_verdict_false_soft">#F2C4B8</color>
    <color name="vs_on_verdict_doubtful_soft">#EBD49B</color>
    <color name="vs_on_verdict_non_verifiable_soft">#D5CBEB</color>

</resources>
