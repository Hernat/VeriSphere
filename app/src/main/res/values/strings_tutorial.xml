<?xml version="1.0" encoding="utf-8"?>
<!--
  VeriSphere tutorial strings — Story 5.1 (UX-DR17, UX spec § Copy Guidelines).
  Kept in a dedicated file (architecture § Resource organisation) because the
  onboarding copy is high-stakes for the first-launch impression. All entries
  merge into the same R.string.* namespace as strings.xml and strings_verdict.xml.

  Story 5.1 amendment (Sprint Change 2026-05-07): tutorial expanded from 3 to
  4 cards. Card 1 = Accessibility activation (new); cards 2-4 = gesture demos.

  Verbatim source: tutorial_card_1_body is the EXACT same phrase as
  R.string.accessibility_explanation_body (Story 1.8.5). Two keys with one
  value is deliberate (CDN #5) so the namespacing per file stays readable
  and Story 7.5's translation pass updates both keys in lockstep.

  Story 7.5 C6 (AC #3) — full V1 French baseline shipped 2026-05-19; the
  Sprint-Change-2026-05-07 card 1 was already French, cards 2/3/4 + shared
  CTAs translated in this pass.
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Story 5.1 — Card 1: Accessibility activation (UX-DR11 amended for Sprint Change 2026-05-07). -->
    <string name="tutorial_card_1_title">Activer VeriSphere Accessibility</string>
    <string name="tutorial_card_1_body">VeriSphere lit l\'écran que tu vérifies — rien d\'autre. Pas de lecture en arrière-plan. Pas d\'actions automatiques. Désactivable à tout moment dans Settings.</string>
    <string name="tutorial_card_1_cta_activate">Activer</string>
    <string name="tutorial_card_1_waiting_hint">VeriSphere s\'activera une fois que tu reviendras des Settings…</string>
    <string name="tutorial_card_1_a11y">Carte 1 sur 4 : activer VeriSphere Accessibility</string>

    <!-- Story 5.1 — Card 2: Long-press to fact-check (UX-DR11 amended; gesture demo). -->
    <string name="tutorial_card_2_title">Long-press pour fact-checker</string>
    <string name="tutorial_card_2_body">Maintiens la bulle 1 seconde sur ce que tu veux vérifier.</string>
    <string name="tutorial_card_2_a11y">Carte 2 sur 4 : long-press pour fact-checker</string>

    <!-- Story 5.1 — Card 3: Drag to move the bubble (UX-DR11 amended; gesture demo). -->
    <string name="tutorial_card_3_title">Glisse pour déplacer la bulle</string>
    <string name="tutorial_card_3_body">La bulle s\'accroche au bord qui te convient.</string>
    <string name="tutorial_card_3_a11y">Carte 3 sur 4 : glisse pour déplacer la bulle</string>

    <!-- Story 5.1 — Card 4: Tap to see your past fact-checks (UX-DR11 amended; gesture demo). -->
    <string name="tutorial_card_4_title">Tape pour revoir tes fact-checks</string>
    <string name="tutorial_card_4_body">Chaque verdict reste dans ton historique local. Pas de compte, pas de cloud.</string>
    <string name="tutorial_card_4_a11y">Carte 4 sur 4 : tape pour revoir tes fact-checks</string>

    <!-- Story 5.1 — Shared CTAs across cards (UX spec § Button Hierarchy, line 735). -->
    <string name="tutorial_cta_next">Suivant</string>
    <string name="tutorial_cta_got_it">OK</string>
    <string name="tutorial_cta_skip">Passer</string>
</resources>
